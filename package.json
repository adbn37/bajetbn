{
  "name": "bajetbn",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "firebase:emulators": "firebase emulators:start",
    "deploy:rules:staging": "firebase use staging && firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions:staging": "firebase use staging && firebase deploy --only functions",
    "deploy:staging": "npm run build -- --mode staging && firebase use staging && firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "verify:structure": "node scripts/verify-structure.mjs",
    "postbuild": "node scripts/generate-service-worker.mjs"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.1.0"
  }
}
