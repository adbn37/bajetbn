rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function underTenMb() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function membershipId(spaceId, uid) {
      return spaceId + '_' + uid;
    }

    function isActiveSpaceMember(spaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid)))
        && (!('status' in firestore.get(/databases/(default)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data)
          || firestore.get(/databases/(default)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.status == 'active');
    }

    function isCollectionSpace(spaceId) {
      return firestore.exists(/databases/(default)/documents/spaces/$(spaceId))
        && firestore.get(/databases/(default)/documents/spaces/$(spaceId)).data.type == 'collection';
    }

    function canEditCollection(spaceId) {
      return isCollectionSpace(spaceId)
        && isActiveSpaceMember(spaceId)
        && firestore.get(/databases/(default)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.role in ['owner', 'admin', 'contributor'];
    }

    function canManageSpaceWork(spaceId) {
      return isActiveSpaceMember(spaceId)
        && firestore.exists(/databases/(default)/documents/spaces/$(spaceId))
        && firestore.get(/databases/(default)/documents/spaces/$(spaceId)).data.type in ['household', 'sme']
        && firestore.get(/databases/(default)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.role in ['owner', 'admin', 'contributor'];
    }

    function isSpaceOwner(spaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/spaces/$(spaceId))
        && firestore.get(/databases/(default)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid;
    }

    function isSmeSpaceOwner(spaceId) {
      return isSpaceOwner(spaceId)
        && firestore.get(/databases/(default)/documents/spaces/$(spaceId)).data.type == 'sme';
    }

    function hasActiveSmePosAccess(spaceId) {
      return signedIn()
        && isActiveSpaceMember(spaceId)
        && firestore.exists(/databases/(default)/documents/smePosAccess/$(membershipId(spaceId, request.auth.uid)))
        && firestore.get(/databases/(default)/documents/smePosAccess/$(membershipId(spaceId, request.auth.uid))).data.status == 'active';
    }

    function canManageSmePosItemPhoto(spaceId) {
      return isSmeSpaceOwner(spaceId)
        || (hasActiveSmePosAccess(spaceId)
          && firestore.get(/databases/(default)/documents/smePosAccess/$(membershipId(spaceId, request.auth.uid))).data.role in ['manager', 'cashier', 'stock_staff']);
    }

    function canReadSmePosItemPhoto(spaceId) {
      return isSmeSpaceOwner(spaceId) || hasActiveSmePosAccess(spaceId);
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && isImageOrPdf() && underTenMb();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /spaces/{spaceId}/avatar/{fileName} {
      allow read: if isActiveSpaceMember(spaceId);

      allow create: if isSpaceOwner(spaceId)
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size < 700 * 1024;

      allow update: if false;
      allow delete: if isSpaceOwner(spaceId);
    }

    match /spaces/{spaceId}/payment-proofs/{assignmentId}/{fileName} {
      allow read: if isActiveSpaceMember(spaceId);
      allow create: if isActiveSpaceMember(spaceId) && isImageOrPdf() && underTenMb();
      allow update, delete: if false;
    }

    match /spaces/{spaceId}/chat-attachments/{uid}/{attachmentId}/{fileName} {
      allow read: if isActiveSpaceMember(spaceId);
      allow create: if isActiveSpaceMember(spaceId)
        && request.auth.uid == uid
        && isImageOrPdf()
        && underTenMb();
      allow update: if false;
      allow delete: if isActiveSpaceMember(spaceId)
        && request.auth.uid == uid;
    }

    match /spaces/{spaceId}/work-items/{itemId}/{fileName} {
      allow read: if isActiveSpaceMember(spaceId);
      allow create: if canManageSpaceWork(spaceId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if canManageSpaceWork(spaceId);
    }

    match /spaces/{spaceId}/collection-items/{itemId}/{fileName} {
      allow read: if isCollectionSpace(spaceId) && isActiveSpaceMember(spaceId);
      allow create: if canEditCollection(spaceId)
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if canEditCollection(spaceId);
    }

    match /spaces/{spaceId}/sme-pos-items/{fileName} {
      allow read: if canReadSmePosItemPhoto(spaceId);
      allow create: if canManageSmePosItemPhoto(spaceId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if canManageSmePosItemPhoto(spaceId);
    }

    // General transaction receipts are stored below users/{uid}/transaction-receipts.
    // The user-scoped rule above limits access to the signed-in owner and accepts images/PDFs under 10 MB.
    match /spaces/{spaceId}/receipts/{allPaths=**} {
      allow read, write: if false; // Reserved: transaction receipts must use the private user path.
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
