rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function membershipId(spaceId, uid) {
      return spaceId + '_' + uid;
    }

    function isSpaceMember(spaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid)))
        && (!('status' in get(/databases/$(database)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data)
          || get(/databases/$(database)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.status == 'active');
    }

    function isSpaceOwner(spaceId) {
      return isSpaceMember(spaceId)
        && get(/databases/$(database)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.role == 'owner';
    }

    function isSpaceManager(spaceId) {
      return isSpaceMember(spaceId)
        && get(/databases/$(database)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.role in ['owner', 'admin'];
    }

    function isCollectionSpace(spaceId) {
      return exists(/databases/$(database)/documents/spaces/$(spaceId))
        && get(/databases/$(database)/documents/spaces/$(spaceId)).data.type == 'collection';
    }

    function canEditCollection(spaceId) {
      return isCollectionSpace(spaceId)
        && isSpaceMember(spaceId)
        && get(/databases/$(database)/documents/spaceMembers/$(membershipId(spaceId, request.auth.uid))).data.role in ['owner', 'admin', 'contributor'];
    }

    function validCollectionItem(data) {
      return data.keys().hasOnly([
          'displayId', 'spaceId', 'ownerId', 'createdBy', 'name', 'category', 'brand',
          'series', 'variant', 'condition', 'conditionNote', 'barcodes', 'internalCode',
          'primaryBarcode', 'photos', 'primaryPhotoId',
          'quantity', 'storageLocation', 'purchasePriceMinor', 'estimatedValueMinor',
          'currency', 'notes', 'tags', 'lastMovementId', 'archivedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'displayId', 'spaceId', 'ownerId', 'createdBy', 'name', 'category', 'brand',
          'series', 'variant', 'condition', 'conditionNote', 'barcodes', 'internalCode',
          'quantity', 'storageLocation', 'purchasePriceMinor', 'estimatedValueMinor',
          'currency', 'notes', 'tags', 'archivedAt', 'createdAt', 'updatedAt'
        ])
        && data.displayId is string && data.displayId.size() > 0 && data.displayId.size() <= 80
        && data.spaceId is string && data.ownerId is string && data.createdBy is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.brand is string && data.brand.size() <= 100
        && data.series is string && data.series.size() <= 100
        && data.variant is string && data.variant.size() <= 120
        && data.condition in ['new', 'sealed', 'open_box', 'used', 'damaged', 'other']
        && data.conditionNote is string && data.conditionNote.size() <= 500
        && data.barcodes is list && data.barcodes.size() > 0 && data.barcodes.size() <= 20
        && data.internalCode is string && data.internalCode.size() > 0 && data.internalCode.size() <= 80
        && data.barcodes.hasAny([data.internalCode])
        && (!('primaryBarcode' in data) || (data.primaryBarcode is string && data.primaryBarcode.size() > 0 && data.primaryBarcode.size() <= 240 && data.barcodes.hasAny([data.primaryBarcode])))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 6))
        && (!('primaryPhotoId' in data) || data.primaryPhotoId == null || (data.primaryPhotoId is string && data.primaryPhotoId.size() > 0 && data.primaryPhotoId.size() <= 80))
        && data.quantity is int && data.quantity >= 0 && data.quantity <= 1000000
        && data.storageLocation is string && data.storageLocation.size() <= 160
        && (data.purchasePriceMinor == null || (data.purchasePriceMinor is int && data.purchasePriceMinor >= 0))
        && (data.estimatedValueMinor == null || (data.estimatedValueMinor is int && data.estimatedValueMinor >= 0))
        && data.currency == 'BND'
        && data.notes is string && data.notes.size() <= 2000
        && data.tags is list && data.tags.size() <= 20
        && (!('lastMovementId' in data) || (data.lastMovementId is string && data.lastMovementId.size() > 0 && data.lastMovementId.size() <= 80))
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validCollectionMovement(data) {
      return data.keys().hasOnly([
          'displayId', 'spaceId', 'ownerId', 'itemId', 'itemName', 'createdBy',
          'reason', 'note', 'delta', 'previousQuantity', 'nextQuantity', 'createdAt'
        ])
        && data.keys().hasAll([
          'displayId', 'spaceId', 'ownerId', 'itemId', 'itemName', 'createdBy',
          'reason', 'note', 'delta', 'previousQuantity', 'nextQuantity', 'createdAt'
        ])
        && data.displayId is string && data.displayId.size() > 0 && data.displayId.size() <= 80
        && data.spaceId is string && data.ownerId is string && data.itemId is string
        && data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 120
        && data.createdBy == request.auth.uid
        && data.reason in ['initial', 'acquired', 'sold', 'gifted', 'lost', 'damaged', 'correction', 'other']
        && data.note is string && data.note.size() <= 500
        && data.delta is int && data.delta >= -1000000 && data.delta <= 1000000
        && data.previousQuantity is int && data.previousQuantity >= 0 && data.previousQuantity <= 1000000
        && data.nextQuantity is int && data.nextQuantity >= 0 && data.nextQuantity <= 1000000
        && data.nextQuantity == data.previousQuantity + data.delta
        && data.createdAt == request.time;
    }

    function validOpeningMovement(itemId, data) {
      return ('lastMovementId' in data)
        && existsAfter(/databases/$(database)/documents/collectionItemMovements/$(data.lastMovementId))
        && getAfter(/databases/$(database)/documents/collectionItemMovements/$(data.lastMovementId)).data.itemId == itemId
        && getAfter(/databases/$(database)/documents/collectionItemMovements/$(data.lastMovementId)).data.spaceId == data.spaceId
        && getAfter(/databases/$(database)/documents/collectionItemMovements/$(data.lastMovementId)).data.reason == 'initial'
        && getAfter(/databases/$(database)/documents/collectionItemMovements/$(data.lastMovementId)).data.previousQuantity == 0
        && getAfter(/databases/$(database)/documents/collectionItemMovements/$(data.lastMovementId)).data.nextQuantity == data.quantity;
    }

    function validQuantityUpdate(itemId, before, after) {
      return (
          after.quantity == before.quantity
          && (
            (!('lastMovementId' in before) && !('lastMovementId' in after))
            || (('lastMovementId' in before) && ('lastMovementId' in after) && after.lastMovementId == before.lastMovementId)
          )
        ) || (
          after.quantity != before.quantity
          && ('lastMovementId' in after)
          && (!('lastMovementId' in before) || after.lastMovementId != before.lastMovementId)
          && existsAfter(/databases/$(database)/documents/collectionItemMovements/$(after.lastMovementId))
          && getAfter(/databases/$(database)/documents/collectionItemMovements/$(after.lastMovementId)).data.itemId == itemId
          && getAfter(/databases/$(database)/documents/collectionItemMovements/$(after.lastMovementId)).data.spaceId == after.spaceId
          && getAfter(/databases/$(database)/documents/collectionItemMovements/$(after.lastMovementId)).data.previousQuantity == before.quantity
          && getAfter(/databases/$(database)/documents/collectionItemMovements/$(after.lastMovementId)).data.nextQuantity == after.quantity
          && getAfter(/databases/$(database)/documents/collectionItemMovements/$(after.lastMovementId)).data.createdAt == request.time
        );
    }

    function isSmeSpace(spaceId) {
      return exists(/databases/$(database)/documents/spaces/$(spaceId))
        && get(/databases/$(database)/documents/spaces/$(spaceId)).data.type == 'sme';
    }

    function posAccessId(spaceId, uid) {
      return spaceId + '_' + uid;
    }

    function hasActivePosAccess(spaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/smePosAccess/$(posAccessId(spaceId, request.auth.uid)))
        && get(/databases/$(database)/documents/smePosAccess/$(posAccessId(spaceId, request.auth.uid))).data.status == 'active';
    }

    function isPosManager(spaceId) {
      return isSpaceOwner(spaceId)
        || (hasActivePosAccess(spaceId)
          && get(/databases/$(database)/documents/smePosAccess/$(posAccessId(spaceId, request.auth.uid))).data.role in ['owner', 'manager']);
    }

    function hasPosRole(spaceId, roles) {
      return hasActivePosAccess(spaceId)
        && get(/databases/$(database)/documents/smePosAccess/$(posAccessId(spaceId, request.auth.uid))).data.role in roles;
    }

    function accountAccessId(accountId, uid) {
      return accountId + '_' + uid;
    }

    function ownsAccount(accountId) {
      return signedIn()
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid;
    }

    function canViewAccountBalance(accountId) {
      return signedIn()
        && exists(/databases/$(database)/documents/accountAccess/$(accountAccessId(accountId, request.auth.uid)))
        && get(/databases/$(database)/documents/accountAccess/$(accountAccessId(accountId, request.auth.uid))).data.canViewBalance == true;
    }

    function canViewAccountLedger(accountId) {
      return signedIn()
        && exists(/databases/$(database)/documents/accountAccess/$(accountAccessId(accountId, request.auth.uid)))
        && get(/databases/$(database)/documents/accountAccess/$(accountAccessId(accountId, request.auth.uid))).data.canViewLedger == true;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if false; // Created by the onboarding Cloud Function.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'language', 'currency', 'timezone', 'appearance', 'textSize',
          'notificationsEnabled', 'backgroundRemindersEnabled', 'dueSoonReminders', 'lateReminders',
          'goalReminders', 'sharedPaymentNotifications', 'whatsappRemindersEnabled',
          'browserPushEnabled', 'reminderDaysBefore', 'themeStudioV2', 'spaceAutomationV1', 'updatedAt'
        ])
        && request.resource.data.currency == 'BND'
        && request.resource.data.timezone == 'Asia/Brunei'
        && request.resource.data.language in ['en', 'ms']
        && request.resource.data.appearance in [
          'system', 'black', 'light', 'pink-white', 'black-pink',
          'midnight-teal', 'navy-blue', 'forest-green', 'royal-purple',
          'sand-cream', 'slate-grey', 'ocean-blue', 'high-contrast', 'dark'
        ]
        && request.resource.data.textSize in ['normal', 'large']
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.backgroundRemindersEnabled is bool
        && request.resource.data.dueSoonReminders is bool
        && request.resource.data.lateReminders is bool
        && request.resource.data.goalReminders is bool
        && request.resource.data.sharedPaymentNotifications is bool
        && request.resource.data.whatsappRemindersEnabled is bool
        && request.resource.data.browserPushEnabled is bool
        && request.resource.data.reminderDaysBefore is int
        && request.resource.data.reminderDaysBefore >= 0
        && request.resource.data.reminderDaysBefore <= 30
        && (!('themeStudioV2' in request.resource.data)
          || request.resource.data.themeStudioV2 is map)
        && (!('spaceAutomationV1' in request.resource.data)
          || request.resource.data.spaceAutomationV1 is map);
      allow delete: if false;

      match /commands/{commandId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }


    match /subscriptionAudit/{auditId} {
      allow read, write: if false;
    }

    match /subscriptionCapacityLocks/{lockId} {
      allow read, write: if false;
    }

    match /subscriptionRequests/{requestId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /smePosDeletionAudit/{auditId} {
      allow read, write: if false;
    }

    match /accountDeletionRequests/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    match /accountDeletionCommands/{commandId} {
      allow read, write: if false;
    }

    match /accountDeletionAudit/{auditId} {
      allow read, write: if false;
    }

    match /deletedUsers/{anonymousId} {
      allow read, write: if false;
    }

    match /accountRegistrationRestrictions/{emailHash} {
      allow read, write: if false;
    }

    match /debts/{debtId} {
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create, update, delete: if false;
    }

    match /debtPayments/{paymentId} {
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create, update, delete: if false;
    }
    match /spaces/{spaceId} {
      allow read: if isSpaceMember(spaceId);
      allow create: if false; // Created by entitlement-enforced Cloud Functions.
      allow update: if isSpaceOwner(spaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.type == resource.data.type
        && !(resource.data.type == 'personal' && request.resource.data.archivedAt != null);
      allow delete: if false;
    }

    match /spaceMembers/{memberId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isSpaceMember(resource.data.spaceId));
      allow create: if false; // Created by onboarding, invitations, or entitlement-enforced Cloud Functions.
      allow update, delete: if false; // Membership changes move to Cloud Functions in collaboration phase.
    }

    match /spacePresence/{presenceId} {
      allow read: if signedIn()
        && isSpaceMember(resource.data.spaceId);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'spaceId',
          'uid',
          'activeAt',
          'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'spaceId',
          'uid',
          'activeAt',
          'expiresAt',
          'typingUntil'
        ])
        && request.resource.data.spaceId is string
        && request.resource.data.uid == request.auth.uid
        && presenceId == membershipId(request.resource.data.spaceId, request.auth.uid)
        && isSpaceMember(request.resource.data.spaceId)
        && request.resource.data.activeAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'm')
        && (
          request.resource.data.get('typingUntil', null) == null
          || (
            request.resource.data.typingUntil is timestamp
            && request.resource.data.typingUntil >= request.time
            && request.resource.data.typingUntil <= request.time + duration.value(15, 's')
          )
        );

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.spaceId == resource.data.spaceId
        && presenceId == membershipId(resource.data.spaceId, request.auth.uid)
        && isSpaceMember(resource.data.spaceId)
        && request.resource.data.keys().hasOnly([
          'spaceId',
          'uid',
          'activeAt',
          'expiresAt',
          'typingUntil'
        ])
        && request.resource.data.activeAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'm')
        && (
          request.resource.data.get('typingUntil', null) == null
          || (
            request.resource.data.typingUntil is timestamp
            && request.resource.data.typingUntil >= request.time
            && request.resource.data.typingUntil <= request.time + duration.value(15, 's')
          )
        );

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /collectionItems/{itemId} {
      allow read: if isCollectionSpace(resource.data.spaceId) && isSpaceMember(resource.data.spaceId);
      allow create: if canEditCollection(request.resource.data.spaceId)
        && validCollectionItem(request.resource.data)
        && validOpeningMovement(itemId, request.resource.data)
        && request.resource.data.ownerId == get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.archivedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canEditCollection(resource.data.spaceId)
        && validCollectionItem(request.resource.data)
        && validQuantityUpdate(itemId, resource.data, request.resource.data)
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.displayId == resource.data.displayId
        && request.resource.data.internalCode == resource.data.internalCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /collectionItemMovements/{movementId} {
      allow read: if isCollectionSpace(resource.data.spaceId) && isSpaceMember(resource.data.spaceId);
      allow create: if canEditCollection(request.resource.data.spaceId)
        && validCollectionMovement(request.resource.data)
        && request.resource.data.ownerId == get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId
        && existsAfter(/databases/$(database)/documents/collectionItems/$(request.resource.data.itemId))
        && getAfter(/databases/$(database)/documents/collectionItems/$(request.resource.data.itemId)).data.spaceId == request.resource.data.spaceId
        && getAfter(/databases/$(database)/documents/collectionItems/$(request.resource.data.itemId)).data.name == request.resource.data.itemName
        && getAfter(/databases/$(database)/documents/collectionItems/$(request.resource.data.itemId)).data.lastMovementId == movementId;
      allow update, delete: if false;
    }

    match /smePosSettings/{spaceId} {
      allow read: if isSpaceOwner(spaceId) || hasActivePosAccess(spaceId);
      allow create, update, delete: if false; // Validated by trusted SME POS Cloud Functions.
    }

    match /smePosAccess/{accessId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isSpaceOwner(resource.data.spaceId)
        || isPosManager(resource.data.spaceId)
      );
      allow create, update, delete: if false; // POS roles are assigned by trusted Cloud Functions.
    }

    match /smePosProducts/{productId} {
      allow read: if isSpaceOwner(resource.data.spaceId)
        || hasPosRole(resource.data.spaceId, ['manager']);
      allow create, update, delete: if false;
    }

    match /smePosCustomers/{customerId} {
      allow read: if isSpaceOwner(resource.data.spaceId)
        || hasPosRole(resource.data.spaceId, ['manager']);
      allow create, update, delete: if false;
    }

    match /smePosSellers/{sellerId} {
      allow read: if isSpaceOwner(resource.data.spaceId)
        || hasPosRole(resource.data.spaceId, ['manager'])
        || (hasPosRole(resource.data.spaceId, ['seller']) && resource.data.linkedUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /smePosListings/{listingId} {
      allow read: if isSpaceOwner(resource.data.spaceId)
        || hasPosRole(resource.data.spaceId, ['manager'])
        || (hasPosRole(resource.data.spaceId, ['seller']) && resource.data.sellerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /smePosSellerLedger/{entryId} {
      allow read: if isSpaceOwner(resource.data.spaceId)
        || hasPosRole(resource.data.spaceId, ['manager'])
        || (hasPosRole(resource.data.spaceId, ['seller']) && resource.data.sellerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /smePosSales/{saleId} {
      allow read: if isSpaceOwner(resource.data.spaceId)
        || hasPosRole(resource.data.spaceId, ['manager']);
      allow create, update, delete: if false;
    }

    match /smePosReturns/{returnId} {
      allow read: if isSpaceOwner(resource.data.spaceId) || isPosManager(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /smePosPayouts/{payoutId} {
      allow read: if isSpaceOwner(resource.data.spaceId) || isPosManager(resource.data.spaceId)
        || (hasActivePosAccess(resource.data.spaceId)
          && get(/databases/$(database)/documents/smePosAccess/$(posAccessId(resource.data.spaceId, request.auth.uid))).data.role == 'seller'
          && resource.data.sellerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /smePosCommands/{commandId} {
      allow read, write: if false;
    }

    match /accounts/{accountId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || canViewAccountBalance(accountId));
      allow create, update, delete: if false; // Server-controlled because opening balances are financial postings.
    }

    match /accountAccess/{accessId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || ownsAccount(resource.data.accountId));
      allow create, update, delete: if false; // Provisioned by trusted server workflows.
    }

    match /ledgerEntries/{entryId} {
      allow read: if signedIn() && (ownsAccount(resource.data.accountId) || canViewAccountLedger(resource.data.accountId));
      allow create, update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false; // Custom categories are validated and written by Cloud Functions.
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || isPosManager(resource.data.spaceId)
      );
      allow create, update, delete: if false; // Posted and reversed only by trusted Cloud Functions.
    }

    match /transactionAttachments/{attachmentId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false; // Metadata is validated by trusted Cloud Functions.
    }

    match /recurringTransactionTemplates/{templateId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false; // Created, generated and managed by trusted Cloud Functions.
    }

    match /recurringTransactionRuns/{runId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /budgets/{budgetId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || isPosManager(resource.data.spaceId)
      );
      allow create, update, delete: if false;
    }

    match /goals/{goalId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /goalContributions/{contributionId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /commitments/{commitmentId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || isPosManager(resource.data.spaceId)
        || (!isSmeSpace(resource.data.spaceId) && isSpaceMember(resource.data.spaceId))
      );
      allow create, update, delete: if false;
    }

    match /commitmentPayments/{paymentId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if false;
    }


    match /businessInvoices/{invoiceId} {
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && isSpaceOwner(resource.data.spaceId);

      allow create, update, delete: if false;
    }

    match /businessInvoicePayments/{paymentId} {
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && isSpaceOwner(resource.data.spaceId);

      allow create, update, delete: if false;
    }

    match /businessInvoiceCounters/{spaceId} {
      allow read, write: if false;
    }

    match /businessProfiles/{spaceId} {
      allow read: if signedIn()
        && isSpaceMember(spaceId);

      allow create: if signedIn()
        && isSmeSpace(spaceId)
        && isSpaceOwner(spaceId)
        && request.resource.data.keys().hasOnly([
          'spaceId', 'ownerId', 'businessName', 'industry',
          'registrationNumber', 'address', 'phone', 'email',
          'fiscalYearStartMonth', 'invoicePrefix',
          'taxEnabled', 'taxName', 'taxRateBps',
          'taxRegistrationNumber', 'payrollEnabled',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.spaceId == spaceId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 160
        && request.resource.data.industry in [
          'general', 'retail', 'service', 'marketplace',
          'rental', 'transport_delivery', 'other'
        ]
        && request.resource.data.registrationNumber is string
        && request.resource.data.registrationNumber.size() <= 100
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 800
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.fiscalYearStartMonth is int
        && request.resource.data.fiscalYearStartMonth >= 1
        && request.resource.data.fiscalYearStartMonth <= 12
        && request.resource.data.invoicePrefix is string
        && request.resource.data.invoicePrefix.size() > 0
        && request.resource.data.invoicePrefix.size() <= 12
        && request.resource.data.taxEnabled is bool
        && request.resource.data.taxName is string
        && request.resource.data.taxName.size() <= 80
        && request.resource.data.taxRateBps is int
        && request.resource.data.taxRateBps >= 0
        && request.resource.data.taxRateBps <= 10000
        && request.resource.data.taxRegistrationNumber is string
        && request.resource.data.taxRegistrationNumber.size() <= 100
        && request.resource.data.payrollEnabled is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && isSpaceOwner(spaceId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'businessName', 'industry', 'registrationNumber',
          'address', 'phone', 'email',
          'fiscalYearStartMonth', 'invoicePrefix',
          'taxEnabled', 'taxName', 'taxRateBps',
          'taxRegistrationNumber', 'payrollEnabled',
          'updatedAt'
        ])
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 160
        && request.resource.data.industry in [
          'general', 'retail', 'service', 'marketplace',
          'rental', 'transport_delivery', 'other'
        ]
        && request.resource.data.fiscalYearStartMonth is int
        && request.resource.data.fiscalYearStartMonth >= 1
        && request.resource.data.fiscalYearStartMonth <= 12
        && request.resource.data.invoicePrefix is string
        && request.resource.data.invoicePrefix.size() > 0
        && request.resource.data.invoicePrefix.size() <= 12
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /businessContacts/{contactId} {
      allow read: if signedIn()
        && isSpaceMember(resource.data.spaceId);

      allow create: if signedIn()
        && isSmeSpace(request.resource.data.spaceId)
        && isSpaceOwner(request.resource.data.spaceId)
        && request.resource.data.keys().hasOnly([
          'displayId', 'spaceId', 'ownerId', 'kind',
          'name', 'phone', 'email', 'address', 'notes',
          'archivedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.displayId is string
        && request.resource.data.displayId.size() > 0
        && request.resource.data.displayId.size() <= 80
        && request.resource.data.kind in [
          'customer', 'vendor', 'both'
        ]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.archivedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && isSpaceOwner(resource.data.spaceId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.displayId == resource.data.displayId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kind', 'name', 'phone', 'email',
          'address', 'notes', 'archivedAt', 'updatedAt'
        ])
        && request.resource.data.kind in [
          'customer', 'vendor', 'both'
        ]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && (
          request.resource.data.archivedAt == null
          || request.resource.data.archivedAt is timestamp
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /spaceInvitations/{invitationId} {
      allow read: if signedIn() && (
        isSpaceManager(resource.data.spaceId)
        || (request.auth.token.email is string && resource.data.email == request.auth.token.email.lower())
      );
      allow create, update, delete: if false;
    }

    match /sharedBillAssignments/{assignmentId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /sharedBillPayments/{paymentId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /sharedBillPaymentReversals/{reversalId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spaceMessages/{messageId} {
      allow read: if signedIn()
        && isSpaceMember(resource.data.spaceId);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'spaceId',
          'senderUid',
          'body',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'spaceId',
          'senderUid',
          'body',
          'createdAt'
        ])
        && request.resource.data.spaceId is string
        && isSpaceMember(request.resource.data.spaceId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
    match /spaceAnnouncements/{announcementId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spacePolls/{pollId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spacePollVotes/{voteId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spaceApprovals/{approvalId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spaceActivities/{activityId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spaceWorkItems/{itemId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /tripItineraryItems/{itemId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /tripTasks/{taskId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /tripBookings/{bookingId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }
    match /sharedExpenses/{expenseId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /sharedExpenseShares/{shareId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /sharedExpensePayments/{paymentId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /spaceFunds/{spaceId} {
      allow read: if signedIn() && isSpaceMember(spaceId);
      allow create, update, delete: if false;
    }

    match /spaceFundContributions/{contributionId} {
      allow read: if signedIn() && isSpaceMember(resource.data.spaceId);
      allow create, update, delete: if false;
    }

    match /userNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    match /pushDevices/{deviceId} {
      allow read, create, update, delete: if false; // Managed only by trusted Cloud Functions.
    }

    match /reminderHistory/{reminderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'itemType', 'itemId', 'itemName', 'spaceId', 'dueDate',
          'action', 'message', 'phone', 'createdAt'
        ])
        && request.resource.data.itemType in ['bill', 'instalment', 'goal', 'shared_bill', 'recurring_transaction']
        && request.resource.data.action in ['marked_reminded', 'whatsapp_opened'];
      allow update, delete: if false;
    }

    match /collaborationCommands/{commandId} {
      allow read, write: if false;
    }

    match /financialCommands/{commandId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
